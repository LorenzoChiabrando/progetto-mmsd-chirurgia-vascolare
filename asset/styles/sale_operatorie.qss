/* =========================================
   SFONDO GENERALE
========================================= */
ViewSaleOperatorie {
    background-color: #f1f5f9;
}

/* =========================================
   PAGINA SCORREVOLE (banda + calendario scorrono insieme)
========================================= */
QScrollArea#ScrollPagina {
    background: transparent;
    border: none;
}
QWidget#ContenutoPagina {
    background: transparent;
}

/* =========================================
   PAGINA SELEZIONE
========================================= */
QLabel#TitoloSelezione {
    font-family: "Segoe UI";
    font-size: 34px;
    font-weight: bold;
    color: #1e1b4b;
    letter-spacing: 1px;
}

QFrame#AccentBarSelezione {
    background-color: #6f42c1;
    border-radius: 3px;
    border: none;
}

QLabel#SottoTitoloSelezione {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #64748b;
    letter-spacing: 0.3px;
}

/* =========================================
   BARRA NAVIGAZIONE
========================================= */
QPushButton#btnNav {
    background-color: #e2e8f0;
    color: #334155;
    font-weight: bold;
    font-size: 20px;
    border-radius: 23px;
    border: none;
}
QPushButton#btnNav:hover {
    background-color: #6f42c1;
    color: white;
}

QPushButton#btnMeseAnno {
    font-family: "Segoe UI", sans-serif;
    font-size: 26px;
    font-weight: bold;
    color: #1e293b;
    background-color: transparent;
    border: none;
    padding: 4px 20px;
    border-radius: 10px;
}
QPushButton#btnMeseAnno:disabled {
    color: #1e293b;
    background-color: transparent;
}

/* =========================================
   ESITO DELLA PIANIFICAZIONE (optimization_summary.py)
========================================= */
QFrame#RiepilogoOttimizzazione {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-left: 6px solid #6f42c1;
    border-radius: 10px;
}
QLabel#TitoloRiepilogo {
    font-size: 10px;
    font-weight: bold;
    color: #94a3b8;
    letter-spacing: 1px;
}
QLabel#ValoreObiettivo {
    font-size: 22px;
    font-weight: bold;
    color: #6f42c1;
}
QLabel#ValoreRiepilogo {
    font-size: 14px;
    font-weight: bold;
    color: #1e293b;
}
QLabel#DettaglioRiepilogo,
QLabel#NotaRiepilogo {
    font-size: 11px;
    color: #64748b;
}
QLabel#DifferenzaObiettivo {
    font-size: 13px;
    font-weight: bold;
    border-radius: 10px;
    padding: 3px 10px;
}
QLabel#DifferenzaObiettivo[tono="uguale"] { color: #475569; background-color: #f1f5f9; }
QLabel#DifferenzaObiettivo[tono="peggio"] { color: #b91c1c; background-color: #fee2e2; }
QLabel#DifferenzaObiettivo[tono="meglio"] { color: #15803d; background-color: #dcfce7; }
QLabel#StatoPiano {
    font-size: 12px;
    font-weight: bold;
    color: #15803d;
}
QLabel#StatoPiano[modificato="true"] {
    color: #b45309;
}
QPushButton#BtnRipristinaModello {
    min-height: 32px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1.5px solid #6f42c1;
    background: #ffffff;
    color: #6f42c1;
    font-weight: bold;
}
QPushButton#BtnRipristinaModello:hover { background: #f5f3ff; }
QPushButton#BtnRipristinaModello:disabled {
    color: #94a3b8;
    border-color: #e2e8f0;
    background: #f8fafc;
}

/* =========================================
   BARRA DEI FILTRI (struttura in calendar_toolbar.py)
========================================= */
QFrame#BarraStrumenti {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}
QFrame#BarraStrumentiDivisore {
    background-color: #e2e8f0;
    border: none;
}
QLabel#LblGruppoBarra {
    color: #64748b;
    font-size: 11px;
    font-weight: bold;
}
QLabel#LblInfoBarra {
    color: #64748b;
    font-size: 12px;
}

/* Alternative a segmenti: i pulsanti di un gruppo si toccano e solo i bordi esterni
   sono arrotondati, così si legge che se ne sceglie uno. */
QFrame#Segmentato {
    background: transparent;
    border: none;
}
QPushButton#BtnSegmento {
    min-height: 30px;
    padding: 0 12px;
    border: 1px solid #cbd5e1;
    border-radius: 0;
    background: #ffffff;
    color: #475569;
    font-weight: bold;
}
QPushButton#BtnSegmento[posizione="primo"] {
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
}
QPushButton#BtnSegmento[posizione="mezzo"] {
    border-left: none;
}
QPushButton#BtnSegmento[posizione="ultimo"] {
    border-left: none;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}
QPushButton#BtnSegmento[posizione="unico"] {
    border-radius: 7px;
}
/* La Versione è la scelta più importante: pulsanti più grandi degli altri filtri. */
QFrame#Segmentato[evidenza="true"] QPushButton#BtnSegmento {
    min-height: 36px;
    padding: 0 22px;
    font-size: 14px;
}
QPushButton#BtnSegmento:hover {
    background: #f5f3ff;
    color: #5b21b6;
}
QPushButton#BtnSegmento:checked {
    background: #6f42c1;
    color: #ffffff;
    border-color: #6f42c1;
}
QPushButton#BtnSegmento:disabled {
    background: #f1f5f9;
    color: #94a3b8;
}
QPushButton#BtnSegmento:checked:disabled {
    background: #94a3b8;
    color: #ffffff;
    border-color: #94a3b8;
}

/* Esporta PDF: bordo e testo nel colore della sezione, icona del documento. */
QPushButton#BtnEsportaPdf {
    min-height: 36px;
    padding: 0 18px 0 14px;
    border-radius: 8px;
    border: 1.5px solid #6f42c1;
    background: #ffffff;
    color: #6f42c1;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#BtnEsportaPdf:hover {
    background: #f5f3ff;
}
QPushButton#BtnEsportaPdf:pressed {
    background: #ede9fe;
}
QPushButton#BtnEsportaPdf:disabled {
    background: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

/* =========================================
   BOTTONE PIANIFICA
========================================= */
QPushButton#BtnPianifica {
    background-color: #4f46e5;
    color: white;
    font-weight: bold;
    font-size: 14px;
    border-radius: 10px;
    border: none;
    padding: 0px 20px;
    letter-spacing: 0.5px;
}
QPushButton#BtnPianifica:hover {
    background-color: #4338ca;
}
QPushButton#BtnPianifica:pressed {
    background-color: #3730a3;
}

/* =========================================
   BOTTONE PULISCI
========================================= */
QPushButton#BtnPulisci {
    background-color: #ffffff;
    color: #dc2626;
    font-weight: bold;
    font-size: 13px;
    border-radius: 8px;
    border: 1.5px solid #fca5a5;
    padding: 0px 20px;
    letter-spacing: 0.5px;
}
QPushButton#BtnPulisci:hover {
    background-color: #fef2f2;
    border-color: #dc2626;
}
QPushButton#BtnPulisci:pressed {
    background-color: #fee2e2;
}

/* =========================================
   BOTTONE CONVALIDA
========================================= */
QPushButton#BtnConvalida {
    background-color: #16a34a;
    color: white;
    font-weight: bold;
    border-radius: 10px;
    font-size: 16px;
    letter-spacing: 1px;
    border: none;
}
QPushButton#BtnConvalida:hover {
    background-color: #15803d;
}

/* =========================================
   SCROLLBAR
========================================= */
QScrollBar:horizontal {
    border: none; background: #e2e8f0;
    height: 8px; border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #94a3b8; min-width: 30px; border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #475569; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal
    { border: none; background: none; width: 0; }

QScrollBar:vertical {
    border: none; background: #e2e8f0;
    width: 8px; border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #94a3b8; min-height: 30px; border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #475569; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical
    { border: none; background: none; height: 0; }

/* =========================================
   TABELLA
========================================= */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 10px;
    color: #1e293b;
    outline: 0;
}
QTableWidget::item { padding: 6px 8px; }
QTableWidget[compact="true"]::item { padding: 0px; }
QTableWidget::item:selected {
    background-color: #ede9fe;
    color: #4c1d95;
}

/* Sfondo dell'area vuota oltre le sezioni (fix rettangolo grigio OS) */
QHeaderView {
    background-color: #f8fafc;
    border: none;
}

QHeaderView::section:horizontal {
    background-color: #e2e8f0;
    color: #334155;
    font-weight: bold;
    font-size: 14px;
    border: none;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
    padding: 8px 4px;
}

QHeaderView::section:vertical {
    background-color: #f8fafc;
    color: #334155;
    font-weight: bold;
    font-size: 12px;
    border: none;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
    padding: 4px 10px;
    min-width: 120px;
}

QTableCornerButton::section {
    background-color: #e2e8f0;
    border: none;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
}

/* ── Celle Operazione ─────────────────────────────── */
QFrame#CellaOperazione {
    background-color: #ffffff;
    border: 1px solid #e8edf3;
    border-radius: 0px;
}
QFrame#CellaOperazione:hover {
    background-color: #f0f4ff;
    border-color: #a5b4fc;
}
QFrame#CellaOperazioneOggi {
    background-color: #fffbeb;
    border: 1px solid #fcd34d;
    border-radius: 0px;
}
QFrame#CellaOperazioneOggi:hover {
    background-color: #fef3c7;
}
QFrame#CellaVuota {
    background-color: #f8fafc;
    border: none;
    border-radius: 0px;
}
/* ── Blocchi per sala (colori in calendar_presentation.ROOM_COLORS) ── */
QFrame#CellaOperazione[sala="OR-1"], QFrame#CellaOperazioneOggi[sala="OR-1"],
QFrame#CellaOperazione[sala="OR-1"]:hover, QFrame#CellaOperazioneOggi[sala="OR-1"]:hover {
    border-left: 4px solid #0284c7;
}
QFrame#CellaOperazione[sala="OR-2"], QFrame#CellaOperazioneOggi[sala="OR-2"],
QFrame#CellaOperazione[sala="OR-2"]:hover, QFrame#CellaOperazioneOggi[sala="OR-2"]:hover {
    border-left: 4px solid #0d9488;
}
QFrame#CellaVuota[sala="OR-1"], QFrame#SlotVuotoClickable[sala="OR-1"] {
    background-color: #f0f9ff;
}
QFrame#CellaVuota[sala="OR-2"], QFrame#SlotVuotoClickable[sala="OR-2"] {
    background-color: #f0fdfa;
}
QFrame#SlotVuotoClickable[sala="OR-1"]:hover { background-color: #e0f2fe; border-color: #0284c7; }
QFrame#SlotVuotoClickable[sala="OR-2"]:hover { background-color: #ccfbf1; border-color: #0d9488; }
QFrame#SlotVuotoClickable[sala="OR-1"]:hover QLabel#LblSlotVuoto { color: #0284c7; }
QFrame#SlotVuotoClickable[sala="OR-2"]:hover QLabel#LblSlotVuoto { color: #0d9488; }

QLabel#LblOraOp {
    font-size: 12px;
    font-weight: bold;
    color: #4338ca;
    background: transparent;
    border: none;
}
QLabel#LblCompactOp {
    color: #4c1d95;
    font-size: 7px;
    font-weight: bold;
    background: transparent;
    border: none;
}
QLabel#BadgeDurataOp {
    font-size: 10px;
    font-weight: bold;
    color: #6366f1;
    background-color: #eef2ff;
    border: 1px solid #c7d2fe;
    border-radius: 6px;
    padding: 1px 6px;
}
QLabel#BadgeSalaOp {
    font-size: 10px;
    font-weight: bold;
    color: #0369a1;
    background-color: #e0f2fe;
    border: 1px solid #7dd3fc;
    border-radius: 6px;
    padding: 1px 6px;
}
QLabel#BadgeSalaOp[sala="OR-2"] {
    color: #0f766e;
    background-color: #ccfbf1;
    border-color: #5eead4;
}
QLabel#LblNomePazOp {
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
    background: transparent;
    border: none;
}
QLabel#LblSubOp {
    font-size: 11px;
    color: #7c8fa6;
    background: transparent;
    border: none;
}
QFrame#SlotVuotoClickable {
    background-color: #f8fafc;
    border: 1.5px dashed #cbd5e1;
    border-radius: 0px;
}
QFrame#SlotVuotoClickable:hover {
    background-color: #eff6ff;
    border-color: #93c5fd;
}
QLabel#LblSlotVuoto {
    font-size: 22px;
    font-weight: bold;
    color: #cbd5e1;
    background: transparent;
    border: none;
}
QFrame#SlotVuotoClickable:hover QLabel#LblSlotVuoto {
    color: #3b82f6;
}

QLabel#BadgeComplessitaOp {
    font-size: 10px;
    font-weight: bold;
    color: #7c3aed;
    background-color: #ede9fe;
    border: 1px solid #c4b5fd;
    border-radius: 6px;
    padding: 1px 6px;
}
