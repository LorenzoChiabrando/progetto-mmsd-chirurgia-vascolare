/* =========================================
   SFONDO GENERALE
========================================= */
ViewScadenzario {
    background-color: #f1f5f9;
}

/* =========================================
   PAGINA SELEZIONE
========================================= */
QLabel#TitoloSelezione {
    font-family: "Segoe UI";
    font-size: 34px;
    font-weight: bold;
    color: #1e1b4b;
    letter-spacing: 1px;
}

QFrame#AccentBarSelezione {
    background-color: #4338ca;
    border-radius: 3px;
    border: none;
}

QLabel#SottoTitoloSelezione {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #64748b;
    letter-spacing: 0.3px;
}

/* =========================================
   BARRA NAVIGAZIONE
========================================= */
QPushButton#btnNav {
    background-color: #e2e8f0;
    color: #334155;
    font-weight: bold;
    font-size: 20px;
    border-radius: 23px;
    border: none;
}
QPushButton#btnNav:hover {
    background-color: #4338ca;
    color: white;
}

QPushButton#btnMeseAnno {
    font-family: "Segoe UI", sans-serif;
    font-size: 36px;
    font-weight: bold;
    color: #1e293b;
    background-color: transparent;
    border: none;
    padding: 4px 20px;
    border-radius: 10px;
}
QPushButton#btnMeseAnno:hover {
    color: #4338ca;
    background-color: #e0e7ff;
}


/* =========================================
   BARRA DEI FILTRI (struttura in calendar_toolbar.py)
========================================= */
QFrame#BarraStrumenti {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}
QFrame#BarraStrumentiDivisore {
    background-color: #e2e8f0;
    border: none;
}
QLabel#LblGruppoBarra {
    color: #64748b;
    font-size: 11px;
    font-weight: bold;
}
QLabel#LblInfoBarra {
    color: #64748b;
    font-size: 12px;
}

/* Alternative a segmenti: i pulsanti di un gruppo si toccano e solo i bordi esterni
   sono arrotondati, così si legge che se ne sceglie uno. */
QFrame#Segmentato {
    background: transparent;
    border: none;
}
QPushButton#BtnSegmento {
    min-height: 30px;
    padding: 0 12px;
    border: 1px solid #cbd5e1;
    border-radius: 0;
    background: #ffffff;
    color: #475569;
    font-weight: bold;
}
QPushButton#BtnSegmento[posizione="primo"] {
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
}
QPushButton#BtnSegmento[posizione="mezzo"] {
    border-left: none;
}
QPushButton#BtnSegmento[posizione="ultimo"] {
    border-left: none;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
}
QPushButton#BtnSegmento[posizione="unico"] {
    border-radius: 7px;
}
/* La Versione è la scelta più importante: pulsanti più grandi degli altri filtri. */
QFrame#Segmentato[evidenza="true"] QPushButton#BtnSegmento {
    min-height: 36px;
    padding: 0 22px;
    font-size: 14px;
}
QPushButton#BtnSegmento:hover {
    background: #eef2ff;
    color: #3730a3;
}
QPushButton#BtnSegmento:checked {
    background: #4338ca;
    color: #ffffff;
    border-color: #4338ca;
}
QPushButton#BtnSegmento:disabled {
    background: #f1f5f9;
    color: #94a3b8;
}
QPushButton#BtnSegmento:checked:disabled {
    background: #94a3b8;
    color: #ffffff;
    border-color: #94a3b8;
}

/* Esporta PDF: bordo e testo nel colore della sezione, icona del documento. */
QPushButton#BtnEsportaPdf {
    min-height: 36px;
    padding: 0 18px 0 14px;
    border-radius: 8px;
    border: 1.5px solid #4338ca;
    background: #ffffff;
    color: #4338ca;
    font-size: 13px;
    font-weight: bold;
}
QPushButton#BtnEsportaPdf:hover {
    background: #eef2ff;
}
QPushButton#BtnEsportaPdf:pressed {
    background: #e0e7ff;
}
QPushButton#BtnEsportaPdf:disabled {
    background: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

/* =========================================
   PAGINA SCORREVOLE (banda + calendario scorrono insieme)
========================================= */
QScrollArea#ScrollPagina {
    background: transparent;
    border: none;
}
QWidget#ContenutoPagina {
    background: transparent;
}

/* =========================================
   BOTTONE CONVALIDA
========================================= */
QPushButton#BtnConvalida {
    background-color: #16a34a;
    color: white;
    font-weight: bold;
    border-radius: 10px;
    font-size: 16px;
    letter-spacing: 1px;
    border: none;
}
QPushButton#BtnConvalida:hover {
    background-color: #15803d;
}

/* =========================================
   SCROLLBAR
========================================= */
QScrollBar:horizontal {
    border: none; background: #e2e8f0;
    height: 8px; border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #94a3b8; min-width: 30px; border-radius: 4px;
}
QScrollBar::handle:horizontal:hover { background: #475569; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal
    { border: none; background: none; width: 0; }

QScrollBar:vertical {
    border: none; background: #e2e8f0;
    width: 8px; border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #94a3b8; min-height: 30px; border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #475569; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical
    { border: none; background: none; height: 0; }

/* =========================================
   TABELLA CALENDARIO
========================================= */
QTableView {
    background-color: #ffffff;
    gridline-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 13px;
    color: #1e293b;
    outline: 0;
}
QTableView::item { padding: 3px; }
QTableView[compact="true"]::item { padding: 0px; }
QTableView::item:selected {
    background-color: #e0e7ff;
    color: #3730a3;
}

/* Intestazione orizzontale (numeri giorno) */
QHeaderView::section:horizontal {
    background-color: #e2e8f0;
    color: #334155;
    font-weight: bold;
    font-size: 15px;
    border: none;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
    padding: 8px 4px;
}

/* Intestazione verticale — il colore per sezione è gestito
   da ColoredHeaderView; qui solo bordo fallback */
QHeaderView::section:vertical {
    background-color: #f8fafc;
    color: #334155;
    font-weight: bold;
    font-size: 12px;
    border: none;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
    padding: 4px 10px;
    min-width: 140px;
}

QTableCornerButton::section {
    background-color: #e2e8f0;
    border: none;
    border-right: 1px solid #cbd5e1;
    border-bottom: 1px solid #cbd5e1;
}

/* =========================================
   COMBOBOX NELLE CELLE
========================================= */
QComboBox {
    combobox-popup: 0;
    background-color: #ffffff;
    border: 2px solid transparent;
    border-radius: 5px;
    padding: 2px 6px;
    font-size: 13px;
    color: #1e293b;
    font-weight: bold;
}
QComboBox:hover, QComboBox:focus { border: 2px solid #818cf8; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow {
    /* Qt non legge gli URI data: nei fogli di stile, quindi la freccia non compariva. */
    image: url(icons:chevron-down.svg);
}

QComboBox QAbstractItemView {
    border: 1px solid #c7d2fe;
    border-radius: 8px;
    background-color: #ffffff;
    outline: 0;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    min-height: 32px;
    border-radius: 4px;
    color: #1e293b;
}
QComboBox QAbstractItemView::item:hover  { background-color: #e0e7ff; color: #3730a3; }
QComboBox QAbstractItemView::item:selected { background-color: #4338ca; color: white; }

QComboBox QAbstractItemView QScrollBar:vertical {
    border: none; background: #f1f5f9;
    width: 10px; margin: 2px; border-radius: 4px;
}
QComboBox QAbstractItemView QScrollBar::handle:vertical {
    background: #94a3b8; min-height: 20px; border-radius: 4px;
}
QComboBox QAbstractItemView QScrollBar::handle:vertical:hover { background: #4338ca; }
QComboBox QAbstractItemView QScrollBar::add-line:vertical,
QComboBox QAbstractItemView QScrollBar::sub-line:vertical
    { height: 0; background: none; }
